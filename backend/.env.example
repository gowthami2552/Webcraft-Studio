# WebCraft Studio - Environment Variables
# Copy this file to .env and update the values

# Flask secret key - CHANGE THIS IN PRODUCTION
SECRET_KEY=webcraft-studio-secret-key-2026-change-in-production

# JWT secret key - CHANGE THIS IN PRODUCTION  
JWT_SECRET_KEY=webcraft-jwt-secret-2026-change-in-production

# Database path (leave blank for default: backend/database/webcraft.db)
DATABASE_PATH=

# Admin credentials - CHANGE THESE IN PRODUCTION
ADMIN_EMAIL=admin@webcraftstudio.com
ADMIN_PASSWORD=Admin@2026

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug mode (set to False in production)
DEBUG=True
